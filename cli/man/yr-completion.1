.ie \n(.g .ds Aq \(aq
.el .ds Aq '
.TH YR-COMPLETION 1 "" YARA-X "User Commands"
.SH NAME
yr\-completion \- Output shell completion code for the specified shell
.SH SYNOPSIS
\fByr completion\fR [\fB\-h\fR|\fB\-\-help\fR] <\fISHELL\fR>
.SH DESCRIPTION
Output shell completion code for the specified shell
.PP
Examples:
.PP
.nf
yr completion bash > $(brew \-\-prefix)/etc/bash_completion.d/yr
yr completion zsh > "${fpath[1]}/_yr"
.fi
.SH OPTIONS
.TP
\fB\-h\fR, \fB\-\-help\fR
Print help (see a summary with \*(Aq\-h\*(Aq)
.TP
<\fISHELL\fR>
Shell name
.br

.br
\fIPossible values:\fR
.RS 14
.IP \(bu 2
bash
.IP \(bu 2
elvish
.IP \(bu 2
fish
.IP \(bu 2
powershell
.IP \(bu 2
zsh
.RE
.SH "SEE ALSO"
\fByr\fR(1)
