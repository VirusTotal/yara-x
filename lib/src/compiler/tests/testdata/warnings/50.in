rule test_1 {
  strings:
    $s1 = "foo"
    $s2 = "bar"
    $sc_check1 = "baz"
    $sc_check2 = "qux"
  condition:
    1 of ($sc_check*) and 2 of ($s*)
}

rule test_2 {
  strings:
    $s1 = "foo"
    $s2 = "bar"
    $sc_check1 = "baz"
    $sc_check2 = "qux"
  condition:
    2 of ($s*) and 1 of ($sc_check*)
}