rule test_1 {
  strings:
    $s1 = "exec"
    $s2 = "system"
    $s3 = "spawn"
    $start_bytes = { 80 90 }
  condition:
    $start_bytes and any of ($s*)
}

rule test_2 {
  strings:
    $s1 = "exec"
    $s2 = "system"
    $s3 = "spawn"
    $start_bytes = { 80 90 }
  condition:
    any of ($s*) and $start_bytes
}