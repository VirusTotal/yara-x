import "math"

rule test_1 {
  condition:
    uint64(0) % -3 == 2
}

rule test_2 {
  condition:
    -6 \ uint64(0) == 0
}

rule test_3 {
  condition:
    uint64(0) \ 2 \ -2 == 0
}

rule test_4 {
  condition:
    for any x in (0xFFFFFFFFFFFFFFFF, -5) : (x == 1)
}

rule test_5 {
  condition:
    math.to_string(0xFFFFFFFFFFFFFFFF) == "-1"
}
