is_eml: true
headers:
  - key: "return-path"
    value: "<sender@example.com>"
  - key: "from"
    value: "\"Jane Doe\" <sender@example.com>"
  - key: "to"
    value: "\"John Smith\" <recipient@example.com>"
  - key: "subject"
    value: "Meeting Agenda & Attached Report"
  - key: "date"
    value: "Sat, 25 Jul 2026 10:15:00 -0400"
  - key: "mime-version"
    value: "1.0"
  - key: "content-type"
    value: "multipart/mixed; boundary=\"----=_Part_0_12345.67890\""
body: "This is a MIME-encoded message.\n\n------=_Part_0_12345.67890\nContent-Type: multipart/alternative; boundary=\"----=_Part_1_ABCDE.67890\"\n\n------=_Part_1_ABCDE.67890\nContent-Type: text/plain; charset=\"UTF-8\"\nContent-Transfer-Encoding: 7bit\n\nHello John,\n\nHere is the agenda for our meeting tomorrow at 2 PM.\n\nAlso, I have attached the quarterly HTML report for your review.\n\nBest,\nJane\n\n------=_Part_1_ABCDE.67890\nContent-Type: text/html; charset=\"UTF-8\"\nContent-Transfer-Encoding: 7bit\n\n<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Meeting Agenda</title>\n</head>\n<body>\n    <p>Hello John,</p>\n    <p>Here is the agenda for our meeting <strong>tomorrow at 2 PM</strong>.</p>\n    <p>Also, I have attached the quarterly HTML report for your review.</p>\n    <p>Best,<br>Jane</p>\n</body>\n</html>\n\n------=_Part_1_ABCDE.67890--\n\n------=_Part_0_12345.67890\nContent-Type: text/html; charset=\"UTF-8\";\n name=\"quarterly_report.html\"\nContent-Transfer-Encoding: 7bit\nContent-Disposition: attachment;\n filename=\"quarterly_report.html\"\n\n<!DOCTYPE html>\n<html>\n<head>\n    <title>Quarterly Report</title>\n</head>\n<body>\n    <h1>Q2 2026 Performance</h1>\n    <p>Revenue is up 15% this quarter.</p>\n</body>\n</html>\n\n------=_Part_0_12345.67890--\n"
parts:
  - body: ""
  - headers:
      - key: "content-type"
        value: "text/plain; charset=\"UTF-8\""
      - key: "content-transfer-encoding"
        value: "7bit"
    body: "Hello John,\n\nHere is the agenda for our meeting tomorrow at 2 PM.\n\nAlso, I have attached the quarterly HTML report for your review.\n\nBest,\nJane"
  - headers:
      - key: "content-type"
        value: "text/html; charset=\"UTF-8\""
      - key: "content-transfer-encoding"
        value: "7bit"
    body: "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Meeting Agenda</title>\n</head>\n<body>\n    <p>Hello John,</p>\n    <p>Here is the agenda for our meeting <strong>tomorrow at 2 PM</strong>.</p>\n    <p>Also, I have attached the quarterly HTML report for your review.</p>\n    <p>Best,<br>Jane</p>\n</body>\n</html>"
  - headers:
      - key: "content-type"
        value: "text/html; charset=\"UTF-8\"; name=\"quarterly_report.html\""
      - key: "content-transfer-encoding"
        value: "7bit"
      - key: "content-disposition"
        value: "attachment; filename=\"quarterly_report.html\""
    body: "<!DOCTYPE html>\n<html>\n<head>\n    <title>Quarterly Report</title>\n</head>\n<body>\n    <h1>Q2 2026 Performance</h1>\n    <p>Revenue is up 15% this quarter.</p>\n</body>\n</html>"
    filename: "quarterly_report.html"
    disposition: "attachment"